# Copy to .env for LOCAL use and adjust. Never commit a real .env file.
# On a hosting platform, set these as environment variables / secrets in its dashboard instead.

# development | test | demo | production   (any other value is refused at start-up)
#   development: local work, simulator on, demo seed allowed (default password if none is set)
#   demo:        hosted, internet-facing demonstration: simulator on, strong secrets REQUIRED, no secrets printed
#   production:  simulator off, demo seed refused; create accounts with scripts/manage_users.py
HDEWS_ENV=development

# SQLite (default, tested) or PostgreSQL (experimental: pip install "psycopg[binary]"; runtime path untested).
DATABASE_URL=sqlite:///backend/hdews.db
# DATABASE_URL=postgresql://hdews:change-me@localhost:5432/hdews

# Password for the four demo accounts created when the demo data is first loaded (admin, analyst, reviewer,
# viewer). HDEWS_ENV=demo refuses placeholders and anything shorter than 12 characters.
HDEWS_DEMO_PASSWORD=change-me-demo-password

# Key a field gateway must send in the X-HDEWS-Ingest-Key header. Stored when the demo data is first loaded.
# If unset: development prints a generated key once; demo stores a random key without printing it (API off).
FIELD_GATEWAY_INGEST_KEY=change-me-ingest-key

# auto (default) | true | false: load the demo dataset into an EMPTY database at start-up (never in production
# with auto). A database that already has data is never reseeded.
HDEWS_SEED_DEMO=auto

# scripts/start.py: interface and port. Containers use HOST=0.0.0.0; platforms such as Render set PORT.
HOST=127.0.0.1
PORT=8000

# Client address used for login/ingestion rate limits.
#   peer (default): the TCP peer. Correct when clients connect directly.
#   x-forwarded-for-first: behind a proxy that sets the FIRST X-Forwarded-For entry to the real client (Render).
#   x-forwarded-for-last:  behind your own single reverse proxy that appends the client address.
# Only use an X-Forwarded-For option when the app is reachable SOLELY through that proxy.
CLIENT_IP_SOURCE=peer

SESSION_TTL_HOURS=12
ENABLE_DEMO_ENDPOINTS=true
# Background loop: continues simulated telemetry each minute and re-assesses every REASSESSMENT_INTERVAL_S.
ENABLE_BACKGROUND_REASSESSMENT=true
REASSESSMENT_INTERVAL_S=300

# Optional LLM explanations (never used for risk calculation). Leave empty to use the deterministic template.
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=20

# Comma-separated origins allowed to call the API from another host (leave empty: the backend serves the UI).
CORS_ORIGINS=

# Reported by /api/health as "version" (Render's RENDER_GIT_COMMIT is used when this is unset).
# HDEWS_VERSION=
