# Copy to .env and adjust. Never commit a real .env file.

# development | test | production. Demo/simulator endpoints are always disabled in production.
HDEWS_ENV=development

# SQLite (default, tested) or PostgreSQL (experimental: pip install "psycopg[binary]").
DATABASE_URL=sqlite:///backend/hdews.db
# DATABASE_URL=postgresql://hdews:change-me@localhost:5432/hdews

# Password for the four demo accounts created by the seed script (admin, analyst, reviewer, viewer).
HDEWS_DEMO_PASSWORD=change-me-demo-password

# Key a field gateway must send in the X-HDEWS-Ingest-Key header. If unset, the seed script generates one and prints it once.
FIELD_GATEWAY_INGEST_KEY=change-me-ingest-key

SESSION_TTL_HOURS=12
ENABLE_DEMO_ENDPOINTS=true
# Background loop: continues simulated telemetry each minute and re-assesses every REASSESSMENT_INTERVAL_S.
ENABLE_BACKGROUND_REASSESSMENT=true
REASSESSMENT_INTERVAL_S=300

# Optional LLM explanations (never used for risk calculation). Leave empty to use the deterministic template.
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=20

# Comma-separated origins allowed to call the API from another host (leave empty when the backend serves the UI).
CORS_ORIGINS=
